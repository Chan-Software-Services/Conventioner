{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["e2e/**/*.ts"],
  "compilerOptions": {
    "noEmit": true,
    // Node runs the Mongo session's thread (e2e/helpers/mongoSession.ts) by stripping its types,
    // which resolves only an import that names its file whole, `.ts` included.
    "allowImportingTsExtensions": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "es2024",
      "ESNext.Array",
      "ESNext.Collection",
      "ESNext.Error",
      "ESNext.Iterator",
      "ESNext.Promise",
      "dom"
    ],
    "types": ["node"]
  }
}
