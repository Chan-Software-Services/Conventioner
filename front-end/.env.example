# API Configuration
VITE_FLASK_HOST=/api
# The dev server's /api proxy, which `npm run preview` uses too, sends to VITE_BACKEND_URL as the
# shell sets it (vite.config.ts reads process.env, not this file); unset, https://127.0.0.1:5001.
# The compose file sets its own.

# The human check (Cloudflare Turnstile)
# Get the site key from Cloudflare's dashboard, Turnstile, for a widget in Managed mode.
# It must be the site key of the same widget as the back end's TURNSTILE_SECRET_KEY: the two are a
# pair, and a front end holding neither, or one from a different widget, ships a product nobody can
# sign up to or ask a vendor's sign-in code from.
# Blank in test/dev builds, and blank is what this template ships: the human check then loads no
# script and sends a placeholder token, so the flow still reaches the back end, which applies its
# own DISABLE_CAPTCHA bypass. To see the widget locally, set one of Cloudflare's test site keys
# (1x00000000000000000000AA passes unseen, 3x00000000000000000000FF asks for the tick): here for
# `npm run dev`, or as TURNSTILE_SITE_KEY for the docker stack, whose compose file passes it as
# this. `vite build` refuses a test key unless VITE_ALLOW_INSECURE_LOCAL_DEV is on.
VITE_TURNSTILE_SITE_KEY=

# The one thing that lets `npm run build` produce a bundle with no site key above, or a test one. It
# is opt-in and only for a local or measured, never-deployed build - a deployed build must set a
# real site key, and `vite build` refuses without one, because the bundle would otherwise send a
# placeholder token that the back end checks with Cloudflare and Cloudflare refuses: every sign-up
# asked for the check again, naming none of it. See front-end/vite.config.ts, and
# ALLOW_INSECURE_LOCAL_DEV in back-end/.env.example.
VITE_ALLOW_INSECURE_LOCAL_DEV=true

# Error tracking (Sentry), optional: the front-end Sentry project's DSN, baked in at build time.
# Set only on the front-end Vercel project; blank or unset, the bundle has no Sentry chunk and
# sends nothing, as every local build should. A set one must be on a host the
# Content-Security-Policy's connect-src in vercel.json allows, or the build fails naming it.
# VITE_SENTRY_DSN=
